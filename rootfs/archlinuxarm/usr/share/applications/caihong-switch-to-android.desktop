[Desktop Entry]
Type=Application
Name=切换到 Android
Name[en]=Switch to Android
Comment=核对已配置的 Android 启动槽并重启
Comment[en]=Verify the configured Android boot slot and reboot
Exec=/usr/bin/pkexec /usr/local/sbin/caihong-slot android --reboot
Icon=system-reboot
Terminal=false
Categories=System;
Keywords=Android;boot;slot;reboot;
StartupNotify=false
