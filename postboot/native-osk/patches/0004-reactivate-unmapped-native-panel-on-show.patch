+void InputMethodTest::testRecallUnmappedNativePanel()
+{
+    Test::destroyWaylandConnection();
+    QVERIFY(Test::setupWaylandConnection(Test::AdditionalWaylandInterface::Seat | Test::AdditionalWaylandInterface::TextInputManagerV3));
+    auto inputMethod = kwinApp()->inputMethod();
+    inputMethod->setActive(false);
+    inputMethod->setInputMethodProvider(QString(), true);
+    const auto restoreProvider = qScopeGuard([inputMethod]() {
+        inputMethod->setInputMethodProvider(QString(), false);
+        waylandServer()->destroyInputMethodConnection();
+    });
+    auto nativeClient = createNativeInputMethodConnection();
+    QVERIFY(nativeClient);
+    QVERIFY(nativeClient->methodName);
+    QVERIFY(nativeClient->inputPanelV1);
+    FloatingInputMethod provider(nativeClient.get(), nativeClient->methodName, nativeClient->methodVersion);
+    QVERIFY(nativeClient->sync());
+    QCOMPARE(provider.activateCount, 0);
+
+    auto surface = Test::createSurface();
+    auto shellSurface = Test::createXdgToplevelSurface(surface.get());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(1280, 1024), Qt::red);
+    QVERIFY(window);
+    touchNow();
+    waylandServer()->seat()->setFocusedTextInputSurface(window->surface());
+    QVERIFY(Test::waylandSync());
+    auto textInput = std::make_unique<Test::TextInputV3>();
+    textInput->init(Test::waylandTextInputManagerV3()->get_text_input(Test::kwinSeat()->object()));
+    QVERIFY(Test::waylandSync());
+    textInput->enable();
+    textInput->set_surrounding_text(QStringLiteral("initial"), 7, 7);
+    textInput->commit();
+    QVERIFY(Test::waylandSync());
+    QTRY_VERIFY(inputMethod->isActive());
+    QTRY_VERIFY(inputMethod->isVisible());
+    QTRY_COMPARE(provider.activateCount, 1);
+    auto panel = inputMethod->panel();
+    QVERIFY(panel);
+    QVERIFY(panel->surface()->isMapped());
+    QCOMPARE(panel->surface()->size(), QSize(1280, 1024));
+    const RectF applicationGeometry = window->frameGeometry();
+    QSignalSpy activeSpy(inputMethod, &InputMethod::activeChanged);
+
+    // A compositor-hidden, still-mapped panel must keep the existing context.
+    inputMethod->hide();
+    QVERIFY(!inputMethod->isVisible());
+    inputMethod->show();
+    QTRY_VERIFY(inputMethod->isVisible());
+    QVERIFY(nativeClient->sync());
+    QCOMPARE(inputMethod->panel(), panel);
+    QCOMPARE(provider.activateCount, 1);
+    QCOMPARE(provider.deactivateCount, 0);
+
+    // Model the provider's own hide button, without disabling the target.
+    provider.unmap();
+    QVERIFY(nativeClient->sync());
+    QTRY_VERIFY(!panel->surface()->isMapped());
+    QTRY_VERIFY(!inputMethod->isVisible());
+    QVERIFY(inputMethod->isActive());
+    QVERIFY(waylandServer()->seat()->textInputV3()->isEnabled());
+    textInput->set_surrounding_text(QStringLiteral("hidden secret"), 6, 2);
+    textInput->set_content_type(QtWayland::zwp_text_input_v3::content_hint_hidden_text | QtWayland::zwp_text_input_v3::content_hint_sensitive_data,
+                               QtWayland::zwp_text_input_v3::content_purpose_password);
+    textInput->commit();
+    QVERIFY(Test::waylandSync());
+    QVERIFY(nativeClient->sync());
+    QCOMPARE(provider.cachedContext->surroundingText, QStringLiteral("hidden secret"));
+    QCOMPARE(provider.activateCount, 1);
+    QCOMPARE(provider.deactivateCount, 0);
+    QVERIFY(!inputMethod->isVisible());
+
+    QSignalSpy preeditSpy(textInput.get(), &Test::TextInputV3::preeditString);
+    QSignalSpy commitSpy(textInput.get(), &Test::TextInputV3::commitString);
+    provider.cachedContext->preedit_string(0, QStringLiteral("old composition"), QStringLiteral("stale fallback"));
+    QVERIFY(nativeClient->sync());
+    QTRY_COMPARE(preeditSpy.count(), 1);
+    QCOMPARE(preeditSpy.last().first().toString(), QStringLiteral("old composition"));
+
+    // Explicit recall cancels retired composition, then replays state before remap.
+    provider.mapOnActivate = false;
+    inputMethod->show();
+    QVERIFY(nativeClient->sync());
+    QTRY_COMPARE(provider.activateCount, 2);
+    QCOMPARE(provider.deactivateCount, 1);
+    QCOMPARE(provider.lifecycleEvents, QStringList({QStringLiteral("activate"), QStringLiteral("deactivate"), QStringLiteral("activate")}));
+    QVERIFY(provider.cachedContext);
+    auto context = provider.cachedContext.get();
+    QTRY_COMPARE(context->commitCount, 1);
+    QCOMPARE(context->events, QStringList({QStringLiteral("surrounding"), QStringLiteral("content"), QStringLiteral("commit")}));
+    QCOMPARE(context->snapshots.size(), 1);
+    const auto &snapshot = context->snapshots.first();
+    QCOMPARE(snapshot.surroundingText, QStringLiteral("hidden secret"));
+    QCOMPARE(snapshot.cursor, 6u);
+    QCOMPARE(snapshot.anchor, 2u);
+    QCOMPARE(snapshot.hints, 0xc0u);
+    QCOMPARE(snapshot.purpose, 8u);
+    QVERIFY(inputMethod->isActive());
+    QVERIFY(activeSpy.isEmpty());
+    QVERIFY(!inputMethod->isVisible());
+    QTRY_COMPARE(preeditSpy.count(), 2);
+    QCOMPARE(preeditSpy.last().first().toString(), QString());
+    QVERIFY(commitSpy.isEmpty());
+    inputMethod->commitPendingText();
+    QVERIFY(Test::waylandSync());
+    QVERIFY(commitSpy.isEmpty());
+    context->commit_string(context->serial, QStringLiteral("recalled"));
+    QVERIFY(nativeClient->sync());
+    QTRY_COMPARE(commitSpy.count(), 1);
+    QCOMPARE(commitSpy.first().first().toString(), QStringLiteral("recalled"));
+    provider.map();
+    QVERIFY(nativeClient->sync());
+    QTRY_VERIFY(inputMethod->isVisible());
+    QCOMPARE(window->frameGeometry(), applicationGeometry);
+    QCOMPARE(workspace()->activeWindow(), window);
+    QVERIFY(activeSpy.isEmpty());
+
+    // A later explicit show must not revive the provider after focus loss.
+    provider.unmap();
+    QVERIFY(nativeClient->sync());
+    QTRY_VERIFY(!inputMethod->isVisible());
+    waylandServer()->seat()->setFocusedTextInputSurface(nullptr);
+    QVERIFY(Test::waylandSync());
+    QVERIFY(nativeClient->sync());
+    QTRY_VERIFY(!inputMethod->isActive());
+    QTRY_COMPARE(provider.deactivateCount, 2);
+    inputMethod->show();
+    QVERIFY(nativeClient->sync());
+    QCOMPARE(provider.activateCount, 2);
+    QVERIFY(!provider.context());
+    QVERIFY(!inputMethod->isActive());
+    QVERIFY(!inputMethod->isVisible());
+    textInput->disable();
+    textInput->commit();
+    QVERIFY(Test::waylandSync());
+    shellSurface.reset();
+    QVERIFY(Test::waitForWindowClosed(window));
+}
