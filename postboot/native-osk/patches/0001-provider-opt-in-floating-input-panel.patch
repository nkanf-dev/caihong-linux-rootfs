 void InputMethod::setInputMethodCommand(const QString &command)
 {
-    if (m_inputMethodCommand == command) {
-        return;
-    }
-
+    setInputMethodProvider(command, false);
+}
+
+void InputMethod::setInputMethodProvider(const QString &command, bool floating)
+{
+    if (m_inputMethodCommand == command && m_inputMethodFloating == floating) {
+        return;
+    }
+
+    // Retire the old native connection before publishing a new provider policy.
+    stopInputMethod();
     m_inputMethodCommand = command;
+    m_inputMethodFloating = floating;
 
     startInputMethod();
     Q_EMIT availableChanged();
+}
+
+bool InputMethod::isFloatingVirtualKeyboardSurface(const SurfaceInterface *surface) const
+{
+    const auto connection = waylandServer()->inputMethodConnection();
+    return m_inputMethodFloating && connection && surface && surface->client() == connection;
 }
 
 void InputMethod::stopInputMethod()
