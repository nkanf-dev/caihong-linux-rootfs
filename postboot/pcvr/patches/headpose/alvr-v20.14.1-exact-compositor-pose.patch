+int find_compositor(dl_phdr_info* info, size_t, void* output) {
+    auto& module = *static_cast<CompositorModule*>(output);
+    for (unsigned i = 0; i < info->dlpi_phnum; ++i) {
+        const auto& ph = info->dlpi_phdr[i];
+        if (ph.p_type != PT_NOTE || ph.p_memsz < sizeof(ElfW(Nhdr))) continue;
+        const auto* bytes = reinterpret_cast<const unsigned char*>(
+            info->dlpi_addr + ph.p_vaddr);
+        if (has_build_id(bytes, ph.p_memsz)) {
+            module.base = info->dlpi_addr;
+            module.matched = true;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+bool check_pose(const TrackedDevicePose_t& pose) {
+    if (pose.bPoseIsValid != 1 || pose.bDeviceIsConnected != 1 ||
+        pose.eTrackingResult != 200) return false;
+    const auto& a = pose.mDeviceToAbsoluteTracking.m;
+    for (unsigned i = 0; i < 3; ++i) {
+        for (unsigned j = 0; j < 4; ++j) {
+            if (!std::isfinite(a[i][j])) return false;
+        }
+        if (!std::isfinite(pose.vVelocity.v[i]) ||
+            !std::isfinite(pose.vAngularVelocity.v[i])) return false;
+    }
+    for (unsigned i = 0; i < 3; ++i) {
+        for (unsigned j = 0; j < 3; ++j) {
+            float dot = 0;
+            for (unsigned k = 0; k < 3; ++k) dot += a[i][k] * a[j][k];
+            if (std::abs(dot - float(i == j)) > 0.1f) return false;
+        }
+    }
+    const float determinant =
+        a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1]) -
+        a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0]) +
+        a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0]);
+    return std::abs(determinant - 1.0f) <= 0.1f;
+}
+
+// Duplicate copies of the same image pose are acceptable. Different device
+// poses in the same frame must not be silently resolved by address order.
+bool same_matrix(const TrackedDevicePose_t& a, const TrackedDevicePose_t& b) {
+    return std::memcmp(&a.mDeviceToAbsoluteTracking, &b.mDeviceToAbsoluteTracking,
+                       sizeof(HmdMatrix34_t)) == 0;
+}
+
+struct PoseScan {
+    TrackedDevicePose_t pose{};
+    uintptr_t offset = 0;
+    unsigned candidates = 0;
+    bool ambiguous = false;
+};
+
+PoseScan scan_frame(uintptr_t begin, uintptr_t end) {
+    PoseScan result;
+    if (end <= begin || end - begin > maximum_frame_bytes ||
+        end - begin < sizeof(TrackedDevicePose_t)) return result;
+    for (uintptr_t addr = begin; end - addr >= sizeof(TrackedDevicePose_t); addr += 4) {
+        TrackedDevicePose_t candidate;
+        std::memcpy(&candidate, reinterpret_cast<const void*>(addr), sizeof(candidate));
+        if (!check_pose(candidate)) continue;
+        if (result.candidates == 0) {
+            result.pose = candidate;
+            result.offset = addr - begin;
+        } else if (!same_matrix(result.pose, candidate)) {
+            result.ambiguous = true;
+        }
+        ++result.candidates;
+    }
+    return result;
+}
+
+void report_capture(const char* status, uintptr_t pc, const PoseScan& scan) {
+    // Bounded evidence: at most eight records per capture thread.
+    static thread_local unsigned reports = 0;
+    if (reports >= 8) return;
+    ++reports;
+    const auto& m = scan.pose.mDeviceToAbsoluteTracking.m;
+    std::fprintf(stderr,
+        "ALVR_POSE_CAPTURE status=%s pc=%#lx offset=%#lx candidates=%u ambiguous=%u "
+        "matrix=%g,%g,%g,%g;%g,%g,%g,%g;%g,%g,%g,%g\n",
+        status, static_cast<unsigned long>(pc), static_cast<unsigned long>(scan.offset),
+        scan.candidates, unsigned(scan.ambiguous),
+        m[0][0], m[0][1], m[0][2], m[0][3], m[1][0], m[1][1], m[1][2], m[1][3],
+        m[2][0], m[2][1], m[2][2], m[2][3]);
+}
