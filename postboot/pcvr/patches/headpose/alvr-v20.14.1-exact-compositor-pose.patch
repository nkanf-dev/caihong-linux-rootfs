+const TrackedDevicePose_t& find_pose_in_call_stack() {
+    static const CompositorModule module = [] {
+        CompositorModule result;
+        dl_iterate_phdr(find_compositor, &result);
+        return result;
+    }();
+    static thread_local TrackedDevicePose_t snapshot;
+    snapshot = {};
+    unw_context_t context;
+    unw_cursor_t cursor;
+    if (unw_getcontext(&context) < 0 || unw_init_local(&cursor, &context) < 0) {
+        report_capture("unwind-init-failed", 0, {});
+        return snapshot;
+    }
+    for (unsigned frame = 0; frame < 64 && unw_step(&cursor) > 0; ++frame) {
+        unw_word_t ip = 0;
+        if (unw_get_reg(&cursor, UNW_REG_IP, &ip) < 0) continue;
+        const uintptr_t relative_ip = ip >= module.base ? ip - module.base : 0;
+        const bool fixed_hmd_slot = module.matched && relative_ip >= update_begin &&
+                                    relative_ip < update_end;
+        bool target = fixed_hmd_slot ||
+                      (module.matched && relative_ip >= update_async_begin &&
+                       relative_ip < update_async_end);
+        if (!module.matched) {
+            char name[1024] = {};
+            unw_word_t offset = 0;
+            if (unw_get_proc_name(&cursor, name, sizeof(name), &offset) >= 0) {
+                target = std::strcmp(name, "_ZN13CRenderThread11UpdateAsyncEv") == 0 ||
+                         std::strcmp(name, "_ZN13CRenderThread6UpdateEv") == 0;
+            }
+        }
+        if (!target) continue;
+        unw_word_t begin = 0, end = 0;
+        unw_cursor_t caller = cursor;
+        if (unw_get_reg(&cursor, UNW_REG_SP, &begin) < 0 ||
+            unw_step(&caller) <= 0 || unw_get_reg(&caller, UNW_REG_SP, &end) < 0) {
+            report_capture("unwind-frame-failed", relative_ip, {});
+            return snapshot;
+        }
+        PoseScan scan;
+        if (fixed_hmd_slot) {
+            // Update fills a 64-entry TrackedDevicePose_t array here; element
+            // zero is the HMD. The second prediction array is not selected.
+            unw_word_t rbp = 0;
+            if (unw_get_reg(&cursor, UNW_X86_64_RBP, &rbp) >= 0 &&
+                rbp >= update_hmd_below_rbp) {
+                const uintptr_t address = rbp - update_hmd_below_rbp;
+                if (end > begin && end - begin <= maximum_frame_bytes &&
+                    rbp >= begin && rbp < end && address >= begin && address <= end &&
+                    end - address >= sizeof(TrackedDevicePose_t)) {
+                    scan = scan_frame(address, address + sizeof(TrackedDevicePose_t));
+                    scan.offset = address - begin;
+                }
+            }
+        } else {
+            scan = scan_frame(begin, end);
+        }
+        if (scan.candidates != 0 && !scan.ambiguous) {
+            snapshot = scan.pose;
+            report_capture(fixed_hmd_slot ? "exact-build-hmd0" :
+                           (module.matched ? "exact-build-frame" : "named-frame"), relative_ip, scan);
+        } else {
+            report_capture(scan.ambiguous ? "ambiguous-frame" : "no-valid-pose", relative_ip, scan);
+        }
+        return snapshot;
+    }
+    report_capture(module.matched ? "exact-frame-absent" : "symbol-frame-absent", 0, {});
+    return snapshot;
+}
